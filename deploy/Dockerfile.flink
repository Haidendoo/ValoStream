FROM flink:1.18

USER root

# Install Python 3, pip, and system dependencies
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        curl \
        ca-certificates \
        build-essential && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    pip3 install --no-cache-dir \
        apache-flink==1.18.1 \
        h3 \
        shapely && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# SQL format bundle includes the Confluent registry client and Avro dependencies.
RUN curl -fsSL --retry 3 \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-avro-confluent-registry/1.18.1/flink-sql-avro-confluent-registry-1.18.1.jar \
    -o /opt/flink/lib/flink-sql-avro-confluent-registry-1.18.1.jar

USER flink
